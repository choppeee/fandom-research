# ===============================================
# 이 파일을 복사해서 .env.local 로 저장한 뒤 실제 값을 채워넣으세요.
# .env.local 은 절대 GitHub에 올리지 마세요 (.gitignore에 이미 포함됨).
# ===============================================

# Supabase 프로젝트 설정
# (supabase.com 대시보드 > Project Settings > API Keys > "Publishable and secret API keys" 탭에서 확인)
# ※ "Legacy anon, service_role" 탭은 2026년 말 폐지 예정이라 사용하지 않습니다.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=여기에_sb_publishable_로_시작하는_키_붙여넣기

# ⚠️ secret 키는 절대 NEXT_PUBLIC_ 접두사를 붙이지 마세요.
# 이 키는 서버(API Route)에서만 사용되며, 클라이언트에 노출되면 DB 전체가 뚫립니다.
SUPABASE_SECRET_KEY=여기에_sb_secret_로_시작하는_키_붙여넣기

# YouTube Data API v3 키 (Google Cloud Console > API 및 서비스 > 사용자 인증 정보)
YOUTUBE_API_KEY=여기에_유튜브_API_키_붙여넣기

# Anthropic Claude API 키 (console.anthropic.com > API Keys)
ANTHROPIC_API_KEY=여기에_클로드_API_키_붙여넣기

# X(Twitter) API v2 Bearer Token (선택 사항)
# developer.x.com 에서 발급, 검색(recent search) 기능은 유료 티어(Basic 이상)부터 사용 가능.
# 비워두면 X 데이터 수집 없이 YouTube만으로 정상 동작합니다.
X_BEARER_TOKEN=
